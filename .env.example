# Copier ce fichier en ".env" (non versionné) et renseigner vos valeurs réelles.
# Ne jamais committer le fichier ".env" lui-même.

# --- Base comptable Sage (obligatoire) ---
# Chemins vérifiés sur ce poste pour la société de test "Bijou SA" :
SAGE_CHEMIN_BASE_COMPTABLE=C:\Users\Public\Documents\Sage\Entreprise 100c\BIJOU.MAE
SAGE_UTILISATEUR=
SAGE_MOT_DE_PASSE=

# --- Base commerciale Sage (facultative, nécessaire pour articles/documents) ---
SAGE_CHEMIN_BASE_COMMERCIALE=C:\Users\Public\Documents\Sage\Entreprise 100c\Bijou.gcm

# --- Mode sécurité pour les premiers tests ---
# true  = seules lire()/lister() sont autorisées (recommandé au début)
# false = creer()/modifier()/supprimer() sont actives
MODE_LECTURE_SEULE=true

# --- Accès SQL Server en LECTURE SEULE uniquement (vérification de données) ---
SQL_SERVER=
SQL_DATABASE=BIJOU
SQL_READONLY_USERNAME=
SQL_READONLY_PASSWORD=
